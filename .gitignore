# ==============================================================================
# 【1. Poetry Python后端忽略项】
# ==============================================================================

# Poetry虚拟环境（本地生成，无需提交）
backend/.venv/

# 敏感配置文件（包含Oracle/MinIO密钥等）
backend/.env

# Python编译缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 测试缓存
backend/tests/.pytest_cache/
backend/.coverage
htmlcov/

# Poetry临时文件
backend/.python-version
backend/poetry.toml.bak

# ==============================================================================
# 【2. Flutter 移动端前端忽略项】
# ==============================================================================

frontend/mobile/.dart_tool/
frontend/mobile/.flutter-plugins
frontend/mobile/.flutter-plugins-dependencies
frontend/mobile/.flutter-managed/
frontend/mobile/.packages
frontend/mobile/flutter_export_environment.sh

# 编译产物
frontend/mobile/build/
frontend/mobile/ios/Runner/Assets.xcassets/AppIcon.appiconset/
frontend/mobile/ios/Runner/Assets.xcassets/LaunchImage.imageset/

# iOS依赖
frontend/mobile/ios/Pods/
frontend/mobile/ios/Podfile.lock
frontend/mobile/ios/.symlinks/
frontend/mobile/ios/DerivedData/

# Android依赖
frontend/mobile/android/.gradle/
frontend/mobile/android/captures/
frontend/mobile/android/build/
frontend/mobile/android/app/build/

# Flutter缓存
frontend/mobile/.flutter/

# ==============================================================================
# 【3. Web前端（Vue/React）忽略项】
# ==============================================================================

frontend/web/node_modules/
frontend/web/dist/
frontend/web/build/
frontend/web/.env
frontend/web/.env.*
frontend/web/.npmrc
frontend/web/.pnpm-store/
frontend/web/yarn.lock
frontend/web/package-lock.json
frontend/web/.eslintcache
frontend/web/vite.config.ts.timestamp-*
# 编辑器缓存
frontend/web/.vscode/
frontend/web/.idea/

# ==============================================================================
